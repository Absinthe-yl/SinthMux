SINTHMUX_HUB_ADDR=127.0.0.1:8090
SINTHMUX_DEV_TOKEN=change-this-development-token
SINTHMUX_CONNECTOR_HUB_URL=ws://127.0.0.1:8090/ws/v1/connectors/connect
SINTHMUX_CONNECTOR_DEVICE_ID=local-dev
SINTHMUX_CONNECTOR_NAME=Local Development Machine

# Formal mode (requires PostgreSQL; set a public HTTPS URL outside localhost)
# SINTHMUX_DATABASE_URL=postgres://sinthmux:password@127.0.0.1:5432/sinthmux?sslmode=disable
# SINTHMUX_TEST_DATABASE_URL=postgres://sinthmux:password@127.0.0.1:5432/sinthmux_test?sslmode=disable
# SINTHMUX_PUBLIC_URL=http://127.0.0.1:5173
# SINTHMUX_GITHUB_CLIENT_ID=
# SINTHMUX_GITHUB_CLIENT_SECRET=
# Optional centralized GitHub login broker (keeps OAuth credentials off this Hub)
# SINTHMUX_AUTH_BROKER_URL=https://login.example.com
# SINTHMUX_AUTH_BROKER_PUBLIC_KEY=
# After adding a device in the Web UI, configure its device proxy (code name: Connector) with:
# SINTHMUX_CONNECTOR_DEVICE_ID=
# SINTHMUX_CONNECTOR_DEVICE_TOKEN=
